# =============================================================================
# wg-relay configuration
#
# Edit the values below, then run:  ./install.sh
# The installer warns you if every value is still the default.
#
# Format: KEY=value, one per line. Quotes are optional. Comments start with #.
# This file is PARSED, not executed: no $variables or $(commands).
# Unknown keys are rejected, so typos are caught before anything changes.
# This file never contains secrets; keys live in their own files.
# =============================================================================


# ----- WireGuard tunnel ------------------------------------------------------

# Interface name. Also selects the systemd unit wg-quick@<name>.
WG_INTERFACE=wg0

# UDP port the VPS listens on. Must also be open in any provider-level
# firewall / security group (the installer cannot change those).
WG_PORT=51820

# This VPS's tunnel address, with the tunnel subnet prefix.
WG_SERVER_ADDRESS=10.250.0.1/24

# OPNsense's tunnel address (a single /32). Inbound port forwards go here.
WG_PEER_ADDRESS=10.250.0.2/32

# Tunnel MTU. 1380 leaves headroom for LTE / CGNAT paths. Use the same value
# on the OPNsense WireGuard instance.
WG_MTU=1380

# Where this VPS's private key lives (OPNsense shows its public half as the
# peer public key). The installer generates it, or you paste one, or it comes
# from a migration block. Kept on re-runs unless you choose to change keys.
WG_PRIVATE_KEY_FILE=/etc/wireguard/private.key

# Pre-shared key: empty = not decided, none = no pre-shared key, or a key file
# path. Set by the installer from your answers.
WG_PRESHARED_KEY_FILE=

# OPNsense instance public key (VPN > WireGuard > Instances > Public key).
# Not secret. Set by the installer from your answer, or edit it here.
WG_PEER_PUBLIC_KEY=

# Source addresses accepted from the peer (comma separated, IPv4 only).
# The default assumes OPNsense outbound-NATs traffic onto its tunnel address.
# If OPNsense does NOT NAT, add your LAN subnets:
#   WG_PEER_ALLOWED_IPS=10.250.0.2/32, 192.168.1.0/24
# 0.0.0.0/0 is rejected: it would route this VPS's own traffic into the tunnel.
WG_PEER_ALLOWED_IPS=10.250.0.2/32


# ----- Host networking -------------------------------------------------------

# "auto" = the interface carrying this VPS's route to the Internet.
# Set a name (eth0, ens3, enp1s0, ...) only if detection picks the wrong one.
WAN_INTERFACE=auto

# Ports SSH is allowed on. "auto" = union of sshd -T, listening sockets,
# ssh.socket, and the port of the SSH session running the installer.
# Or list them explicitly:  SSH_PORTS=22 2222
SSH_PORTS=auto

ENABLE_IPV4_FORWARDING=yes

# The tunnel is IPv4-only, so this is normally "no". If set to "yes", the
# installer also keeps router advertisements working on the WAN.
ENABLE_IPV6_FORWARDING=no

# Connection-tracking table size. Empty = kernel default. Raise it (e.g. 131072)
# only if the whole household relays through here and you see
# "nf_conntrack: table full" in the kernel log.
CONNTRACK_MAX=


# ----- Relay behaviour -------------------------------------------------------

# Let the peer use this VPS as its Internet gateway (failover egress).
RELAY_EGRESS=yes

# Masquerade egress traffic behind this VPS's public address.
MASQUERADE_EGRESS=yes

# Public ports forwarded through the tunnel to WG_PEER_ADDRESS (same port
# number). Space or comma separated; ranges as 8000-8010.
# Mirror every one of these as a port forward on OPNsense's WireGuard interface.
# The VPS's own SSH port and WG_PORT can never be forwarded.
#   FORWARD_TCP_PORTS=80 443
#   FORWARD_UDP_PORTS=
FORWARD_TCP_PORTS=
FORWARD_UDP_PORTS=

# Extra TCP ports on THIS VPS reachable only from the tunnel peer
# (for example a future monitoring exporter). Empty = none.
TUNNEL_INPUT_TCP_PORTS=


# ----- Installer behaviour ---------------------------------------------------

# Seconds before new firewall rules are automatically rolled back unless you
# confirm from a second SSH session.
ROLLBACK_TIMEOUT=120

# Allow running on something other than Debian 13 (e.g. Debian 14, years from now).
ALLOW_UNSUPPORTED_OS=no

# Used by status/summary ONLY when the WAN interface has no public IPv4
# (1:1 NAT providers) and curl is installed. Empty = never contact anything.
PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
