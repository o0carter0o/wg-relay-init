# =============================================================================
# wg-relay firewall unit. GENERATED by install.sh.
#
# Loads ONLY the "inet wg_relay" nftables table, independently of Debian's
# nftables.service (whose stock config and ExecStop flush the WHOLE ruleset).
#
# PartOf/After nftables.service: if someone restarts nftables.service and it
# flushes everything, this unit is restarted after it and puts the table back.
#
#   systemctl stop wg-relay-firewall     removes the table (VPS unfiltered)
#   systemctl start wg-relay-firewall    loads it again
# =============================================================================

[Unit]
Description=wg-relay firewall (nftables table inet wg_relay)
Documentation=man:nft(8)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=nftables.service
PartOf=nftables.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f @NFT_FILE@
ExecReload=/usr/sbin/nft -f @NFT_FILE@
ExecStop=-/usr/sbin/nft delete table inet wg_relay

[Install]
WantedBy=sysinit.target
