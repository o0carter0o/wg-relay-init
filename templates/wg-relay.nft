#!/usr/sbin/nft -f
# =============================================================================
# wg-relay firewall. GENERATED by install.sh from config.env.
# Do not edit here: edit config.env and re-run install.sh (edits are replaced).
#
# Ownership model
#   This file manages exactly ONE table: "inet wg_relay". It never runs
#   "flush ruleset", so tables belonging to other software are untouched.
#   The create / delete / create sequence below replaces the table
#   atomically: nft applies the whole file as a single transaction, so there
#   is never a moment with a half-loaded ruleset.
#
#   If another table also filters the same hooks (ufw, Docker, ...), a packet
#   must be accepted by EVERY base chain: a drop anywhere is final.
#
# SSH and WireGuard are accepted on any interface, not just the WAN, so a
# renamed or replaced NIC can never lock you out of SSH.
# =============================================================================

define WAN_IF    = "@WAN_IF@"
define WG_IF     = "@WG_IF@"
define WG_PORT   = @WG_PORT@
define PEER_ADDR = @PEER_ADDR@

table inet wg_relay {}
delete table inet wg_relay

table inet wg_relay {

    # ------------------------------------------------------------------ sets
    # Port sets can also be changed live (nft add element inet wg_relay
    # fwd_tcp { 8443 }), but install.sh is the source of truth: re-running it
    # restores exactly what config.env says.

    # SSH port(s) on this VPS (detected at install time, or SSH_PORTS).
    set ssh_ports {
        type inet_service
        flags interval
        auto-merge
        @SSH_ELEMENTS@
    }

    # Source addresses permitted from the peer (WG_PEER_ALLOWED_IPS).
    set peer_nets {
        type ipv4_addr
        flags interval
        auto-merge
        @PEER_NETS_ELEMENTS@
    }

    # Public ports DNAT'd through the tunnel to the peer (FORWARD_*_PORTS).
    set fwd_tcp {
        type inet_service
        flags interval
        auto-merge
        @FWD_TCP_ELEMENTS@
    }
    set fwd_udp {
        type inet_service
        flags interval
        auto-merge
        @FWD_UDP_ELEMENTS@
    }

    # Extra TCP ports on THIS VPS reachable only from the peer (TUNNEL_INPUT_TCP_PORTS).
    set tunnel_tcp {
        type inet_service
        flags interval
        auto-merge
        @TUNNEL_TCP_ELEMENTS@
    }

    # =========================================================== FILTERING

    # Traffic addressed to the VPS itself.
    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state invalid drop
        ct state { established, related } accept

        # ICMP: errors are needed for path-MTU discovery (critical for a
        # tunnel); echo is rate-limited.
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        icmp type echo-request limit rate 10/second burst 20 packets accept

        # ICMPv6: neighbor discovery and router advertisements keep this
        # host's own IPv6 working; packet-too-big is required by IPv6.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept
        icmpv6 type echo-request limit rate 10/second burst 20 packets accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "DHCPv6 replies"

        # The tunnel itself, and SSH.
        udp dport $WG_PORT accept comment "WireGuard"
        tcp dport @ssh_ports accept comment "SSH"

        # Services on this VPS that only the peer may reach.
        iifname $WG_IF ip saddr @peer_nets tcp dport @tunnel_tcp accept comment "tunnel-only services"

        counter comment "input-drop"
    }

    # Traffic routed THROUGH the VPS (Internet <-> tunnel).
    chain forward {
        type filter hook forward priority filter; policy drop;

        # Clamp TCP MSS to the outgoing route's MTU so TCP never relies on
        # fragmentation across the tunnel (avoids "some sites hang" issues).
        tcp flags & (syn | rst) == syn tcp option maxseg size set rt mtu comment "MSS clamp"

        ct state invalid drop
        ct state { established, related } accept

        # Inbound: anything that chain dstnat (below) translated. Adding a
        # forwarded port therefore needs no separate filter rule.
        iifname $WAN_IF oifname $WG_IF ct status dnat accept comment "inbound port forwards"

        # Outbound: the peer using this VPS as its Internet gateway.
        @EGRESS_RULE@

        counter comment "forward-drop"
    }

    # No output chain: the VPS may originate any traffic (policy accept).

    # ================================================================= NAT

    # Destination NAT: public ports -> peer's tunnel address (same port).
    # Source addresses are preserved, so OPNsense sees real client IPs.
    chain dstnat {
        type nat hook prerouting priority dstnat; policy accept;

        iifname $WAN_IF meta nfproto ipv4 tcp dport @fwd_tcp dnat ip to $PEER_ADDR comment "inbound TCP forwards"
        iifname $WAN_IF meta nfproto ipv4 udp dport @fwd_udp dnat ip to $PEER_ADDR comment "inbound UDP forwards"
    }

    # Source NAT: egress traffic from the peer leaves with this VPS's address.
    chain srcnat {
        type nat hook postrouting priority srcnat; policy accept;

        @MASQ_RULE@
    }
}
